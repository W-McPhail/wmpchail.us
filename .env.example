# Copy to .env (server reads it from the repo root or server/ via dotenv).

# Postgres — required
DATABASE_URL=postgres://postgres:test@localhost:55432/wmcphail

# Admin login for /admin (blog editor) — required
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie — required (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-too

# Where contact-form inquiries go
CONTACT_EMAIL=mcphailwillow@gmail.com
CONTACT_PHONE=+19148061544

# Email via Resend (https://resend.com). Optional in dev: inquiries are always saved to Postgres.
RESEND_API_KEY=
RESEND_FROM="Willow McPhail <onboarding@resend.dev>"

# SMS via Twilio (https://twilio.com). Optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Server port (Render sets this automatically)
PORT=3000
